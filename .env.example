# Discord bot token
BOT=

# Shared Aegis database
AEGIS_DATABASE=database.aegis

# Detection and moderation
AEGIS_DELETE_THRESHOLD=0.805
AEGIS_TIMEOUT_DAYS=7
AEGIS_COOLDOWN_SECONDS=900
AEGIS_MAX_IMAGE_BYTES=3145728
AEGIS_IMAGE_CACHE_ENTRIES=5000
AEGIS_DM_REPORT_SERVER=Not configured

# Discord channel topic identifiers
AEGIS_LOGGING_IDENTIFIER=.eq.antiscam.logs

# False-positive reports (Discord channel ID; leave blank to disable reports)
AEGIS_FALSE_POSITIVE_CHANNEL_ID=

# Optional authenticated website heartbeat (Python and Rust send the same payload)
WEBSITE_API=
API_KEY=

# Rust dashboard (localhost by default; use a reverse proxy with TLS for public access)
AEGIS_DASHBOARD_BIND=127.0.0.1:8080
AEGIS_DASHBOARD_DATABASE=aegis-dashboard.sqlite3

# Discord OAuth2 application (register this exact callback URL in Developer Portal)
AEGIS_DISCORD_CLIENT_ID=
AEGIS_DISCORD_CLIENT_SECRET=
AEGIS_DISCORD_REDIRECT_URI=http://127.0.0.1:8080/auth/callback
